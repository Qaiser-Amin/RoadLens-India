            <column-instance column="[Fatalities Label]" derivation="User" name="[usr:Fatalities Label:nk]" pivot="key" type="nominal" />
            <column-instance column="[Severity Label]" derivation="User" name="[usr:Severity Label:nk]" pivot="key" type="nominal" />
            <column-instance column="[Reporting Status]" derivation="User" name="[usr:Reporting Status:nk]" pivot="key" type="nominal" />
            <column-instance column="[Coverage Summary]" derivation="User" name="[usr:Coverage Summary:nk]" pivot="key" type="nominal" />
