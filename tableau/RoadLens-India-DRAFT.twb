    <worksheet name="Two-Wheeler Severity KPI">
      <layout-options>
        <title>
          <formatted-text>
            <run>Two-Wheeler Severity KPI</run>
            <run fontcolor="#667a7a" fontsize="9"> | &lt;Parameters.Year&gt; | &lt;Parameters.State&gt; | &lt;Parameters.Metric&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="Vehicles" caption="Vehicles" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column caption="Year" datatype="string" name="[Year]" param-domain-type="list" role="measure" type="nominal" value="&quot;2023&quot;">
              <calculation formula="&quot;2023&quot;" class="tableau" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;2020&quot;" />
                <member value="&quot;2021&quot;" />
                <member value="&quot;2022&quot;" />
                <member value="&quot;2023&quot;" />
              </members>
            </column>
            <column caption="State" datatype="string" name="[State]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation formula="&quot;All&quot;" class="tableau" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;Andaman and Nicobar Islands&quot;" />
                <member value="&quot;Andhra Pradesh&quot;" />
                <member value="&quot;Arunachal Pradesh&quot;" />
                <member value="&quot;Assam&quot;" />
                <member value="&quot;Bihar&quot;" />
                <member value="&quot;Chandigarh&quot;" />
                <member value="&quot;Chhattisgarh&quot;" />
                <member value="&quot;Dadra and Nagar Haveli and Daman and Diu&quot;" />
