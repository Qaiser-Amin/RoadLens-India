      </column>
      <column caption="Reset Compare A" datatype="string" name="[Reset Compare A]" role="dimension" type="nominal">
        <calculation formula="'Kerala'" class="tableau" />
      </column>
      <column caption="Reset Compare B" datatype="string" name="[Reset Compare B]" role="dimension" type="nominal">
        <calculation formula="'Tamil Nadu'" class="tableau" />
      </column>
      <group caption="High Accidents" name="[High Accidents]" name-style="unqualified">
        <groupfilter count="[Parameters].[Top N]" end="top" function="end" units="records">
          <groupfilter direction="DESC" expression="SUM([Accidents])" function="order">
            <groupfilter function="level-members" level="[State]" />
          </groupfilter>
        </groupfilter>
      </group>
      <group caption="High Severity" name="[High Severity]" name-style="unqualified">
        <groupfilter expression="SUM([Paired Accidents]) &gt; 0 AND COUNT([Paired Accidents]) = COUNT([State]) AND [Severity] &gt;= [Parameters].[High Severity Threshold]" function="filter">
          <groupfilter function="level-members" level="[State]" />
        </groupfilter>
      </group>
      <group caption="High Accidents AND High Severity" name="[High Accidents AND High Severity]" name-style="unqualified">
        <groupfilter function="intersection">
          <groupfilter field="[High Accidents]" function="reference" />
          <groupfilter field="[High Severity]" function="reference" />
        </groupfilter>
      </group>
      <semantic-values>
        <semantic-value key="[Country].[Name]" value="&quot;India&quot;" />
      </semantic-values>
    </datasource>
    <datasource caption="Causes" inline="true" name="Causes" version="18.1">
      <connection directory="Data" filename="Causes.csv" server="" workgroup-auth-mode="as-is" class="textscan">
        <relation name="Causes" table="[Causes#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="integer" name="Year" ordinal="0" />
            <column datatype="string" name="State" ordinal="1" />
            <column datatype="string" name="Category" ordinal="2" />
            <column datatype="integer" name="Accidents" ordinal="3" />
            <column datatype="integer" name="Fatalities" ordinal="4" />
            <column datatype="string" name="Source ID" ordinal="5" />
            <column datatype="string" name="Country" ordinal="6" />
            <column datatype="string" name="Record Status" ordinal="7" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column datatype="integer" name="[Year]" role="dimension" type="ordinal" />
      <column datatype="string" name="[State]" role="dimension" type="nominal" semantic-role="[State].[Name]" />
      <column datatype="string" name="[Category]" role="dimension" type="nominal" />
      <column datatype="integer" name="[Accidents]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Fatalities]" role="measure" type="quantitative" />
      <column datatype="string" name="[Source ID]" role="dimension" type="nominal" />
      <column datatype="string" name="[Country]" role="dimension" type="nominal" semantic-role="[Country].[Name]" />
      <column datatype="string" name="[Record Status]" role="dimension" type="nominal" />
      <column caption="Year Filter" datatype="boolean" name="[Year Filter]" role="dimension" type="nominal">
        <calculation formula="[Parameters].[Year] = 'All' OR STR([Year]) = [Parameters].[Year]" class="tableau" />
      </column>
      <column caption="State Filter" datatype="boolean" name="[State Filter]" role="dimension" type="nominal">
        <calculation formula="[Parameters].[State] = 'All' OR [State] = [Parameters].[State]" class="tableau" />
      </column>
      <column caption="Comparison Filter" datatype="boolean" name="[Comparison Filter]" role="dimension" type="nominal">
        <calculation formula="[State] = [Parameters].[Compare A] OR [State] = [Parameters].[Compare B]" class="tableau" />
      </column>
      <column caption="Paired Accidents" datatype="integer" name="[Paired Accidents]" role="measure" type="quantitative">
        <calculation formula="IF NOT ISNULL([Accidents]) AND NOT ISNULL([Fatalities]) THEN [Accidents] END" class="tableau" />
      </column>
      <column caption="Paired Fatalities" datatype="integer" name="[Paired Fatalities]" role="measure" type="quantitative">
        <calculation formula="IF NOT ISNULL([Accidents]) AND NOT ISNULL([Fatalities]) THEN [Fatalities] END" class="tableau" />
      </column>
      <column caption="Severity" datatype="real" name="[Severity]" role="measure" type="quantitative">
        <calculation formula="IF SUM([Paired Accidents]) &gt; 0 THEN 100.0 * SUM([Paired Fatalities]) / SUM([Paired Accidents]) END" class="tableau" />
      </column>
      <column caption="Selected Measure" datatype="real" name="[Selected Measure]" role="measure" type="quantitative">
        <calculation formula="CASE [Parameters].[Metric] WHEN 'Accidents' THEN SUM([Accidents]) WHEN 'Fatalities' THEN SUM([Fatalities]) WHEN 'Severity' THEN [Severity] END" class="tableau" />
      </column>
      <column caption="Accidents Label" datatype="string" name="[Accidents Label]" role="measure" type="nominal">
        <calculation formula="IF COUNT([Accidents]) = 0 THEN 'Unavailable' ELSE STR(SUM([Accidents])) END" class="tableau" />
      </column>
      <column caption="Fatalities Label" datatype="string" name="[Fatalities Label]" role="measure" type="nominal">
        <calculation formula="IF COUNT([Fatalities]) = 0 THEN 'Unavailable' ELSE STR(SUM([Fatalities])) END" class="tableau" />
      </column>
      <column caption="Severity Label" datatype="string" name="[Severity Label]" role="measure" type="nominal">
        <calculation formula="IF ISNULL([Severity]) THEN 'Unavailable: no compatible denominator' ELSE STR(ROUND([Severity],1)) + ' deaths / 100 accidents' END" class="tableau" />
      </column>
      <column caption="Reporting Status" datatype="string" name="[Reporting Status]" role="measure" type="nominal">
        <calculation formula="IF ISNULL([Selected Measure]) THEN 'Unavailable: not reported for selected year/state/category, or denominator unavailable' ELSEIF ([Parameters].[Metric] = 'Accidents' AND COUNT([Accidents]) &lt; COUNT([State])) OR ([Parameters].[Metric] = 'Fatalities' AND COUNT([Fatalities]) &lt; COUNT([State])) OR ([Parameters].[Metric] = 'Severity' AND COUNT([Paired Accidents]) &lt; COUNT([State])) THEN 'Partial coverage: reported/paired observations only' ELSE 'Reported observations in supplied extract' END" class="tableau" />
      </column>
      <column caption="Coverage Summary" datatype="string" name="[Coverage Summary]" role="measure" type="nominal">
        <calculation formula="'Accident observations: ' + STR(COUNT([Accidents])) + '/' + STR(COUNT([State])) + ' | Fatality observations: ' + STR(COUNT([Fatalities])) + '/' + STR(COUNT([State])) + ' | Severity uses paired counts only'" class="tableau" />
      </column>
      <column caption="Dynamic Title" datatype="string" name="[Dynamic Title]" role="dimension" type="nominal">
        <calculation formula="[Parameters].[Year] + ' | ' + [Parameters].[State] + ' | ' + [Parameters].[Metric]" class="tableau" />
      </column>
      <column caption="State Rank" datatype="integer" name="[State Rank]" role="measure" type="quantitative">
        <calculation formula="RANK_UNIQUE([Selected Measure], 'desc')" class="tableau" />
      </column>
      <column caption="Risk Class" datatype="string" name="[Risk Class]" role="measure" type="nominal">
        <calculation formula="IF COUNT([Paired Accidents]) &lt; COUNT([State]) OR ISNULL([Severity]) THEN 'Unclassified: incomplete data' ELSEIF MIN(IIF([High Accidents AND High Severity],1,0))=1 THEN 'High accidents + high severity' ELSEIF MIN(IIF([High Accidents],1,0))=1 THEN 'High accidents' ELSEIF MIN(IIF([High Severity],1,0))=1 THEN 'High severity' ELSE 'Other reported' END" class="tableau" />
      </column>
      <column caption="Reset Label" datatype="string" name="[Reset Label]" role="dimension" type="nominal">
        <calculation formula="'Reset filters'" class="tableau" />
      </column>
      <column caption="Nav Overview" datatype="string" name="[Nav Overview]" role="dimension" type="nominal">
        <calculation formula="'National overview'" class="tableau" />
      </column>
      <column caption="Nav Vehicles" datatype="string" name="[Nav Vehicles]" role="dimension" type="nominal">
        <calculation formula="'Two-wheeler safety'" class="tableau" />
      </column>
      <column caption="Nav Risks" datatype="string" name="[Nav Risks]" role="dimension" type="nominal">
        <calculation formula="'Causes and risk factors'" class="tableau" />
      </column>
      <column caption="Reset Year" datatype="string" name="[Reset Year]" role="dimension" type="nominal">
        <calculation formula="'2023'" class="tableau" />
      </column>
      <column caption="Reset State" datatype="string" name="[Reset State]" role="dimension" type="nominal">
        <calculation formula="'All'" class="tableau" />
      </column>
      <column caption="Reset Metric" datatype="string" name="[Reset Metric]" role="dimension" type="nominal">
        <calculation formula="'Fatalities'" class="tableau" />
      </column>
      <column caption="Reset Top N" datatype="integer" name="[Reset Top N]" role="dimension" type="quantitative">
        <calculation formula="10" class="tableau" />
      </column>
      <column caption="Reset High Severity Threshold" datatype="real" name="[Reset High Severity Threshold]" role="dimension" type="quantitative">
        <calculation formula="50" class="tableau" />
      </column>
      <column caption="Reset Compare A" datatype="string" name="[Reset Compare A]" role="dimension" type="nominal">
        <calculation formula="'Kerala'" class="tableau" />
      </column>
      <column caption="Reset Compare B" datatype="string" name="[Reset Compare B]" role="dimension" type="nominal">
        <calculation formula="'Tamil Nadu'" class="tableau" />
      </column>
      <group caption="High Accidents" name="[High Accidents]" name-style="unqualified">
        <groupfilter count="[Parameters].[Top N]" end="top" function="end" units="records">
          <groupfilter direction="DESC" expression="SUM([Accidents])" function="order">
            <groupfilter function="level-members" level="[State]" />
          </groupfilter>
        </groupfilter>
      </group>
      <group caption="High Severity" name="[High Severity]" name-style="unqualified">
        <groupfilter expression="SUM([Paired Accidents]) &gt; 0 AND COUNT([Paired Accidents]) = COUNT([State]) AND [Severity] &gt;= [Parameters].[High Severity Threshold]" function="filter">
          <groupfilter function="level-members" level="[State]" />
        </groupfilter>
      </group>
      <group caption="High Accidents AND High Severity" name="[High Accidents AND High Severity]" name-style="unqualified">
        <groupfilter function="intersection">
          <groupfilter field="[High Accidents]" function="reference" />
          <groupfilter field="[High Severity]" function="reference" />
        </groupfilter>
      </group>
      <semantic-values>
        <semantic-value key="[Country].[Name]" value="&quot;India&quot;" />
      </semantic-values>
    </datasource>
