                <run>Accidents: &lt;[Vehicles].[sum:Accidents:qk]&gt;
</run>
                <run>Fatalities: &lt;[Vehicles].[sum:Fatalities:qk]&gt;
</run>
                <run>Severity (deaths / 100 accidents): &lt;[Vehicles].[usr:Severity:qk]&gt;
</run>
                <run>Status: &lt;[Vehicles].[usr:Reporting Status:nk]&gt;
</run>
                <run>Coverage: &lt;[Vehicles].[usr:Coverage Summary:nk]&gt;
</run>
