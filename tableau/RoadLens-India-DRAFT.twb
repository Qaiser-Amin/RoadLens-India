            <column caption="High Severity Threshold" datatype="real" name="[High Severity Threshold]" param-domain-type="range" role="measure" type="quantitative" value="50">
              <calculation formula="50" class="tableau" />
              <range min="0.0" max="1000.0" granularity="1.0" />
            </column>
            <column caption="Compare A" datatype="string" name="[Compare A]" param-domain-type="list" role="measure" type="nominal" value="&quot;Kerala&quot;">
