          <filter class="categorical" column="[Roads].[none:Year Filter:nk]" context="true">
            <groupfilter function="member" level="[none:Year Filter:nk]" member="true" />
          </filter>
          <filter class="categorical" column="[Roads].[none:State Filter:nk]" context="true">
            <groupfilter function="member" level="[none:State Filter:nk]" member="true" />
          </filter>
          <sort column="[Roads].[none:Category:nk]" direction="DESC" using="[Roads].[usr:Selected Measure:qk]" class="computed" />
          <aggregation value="true" />
