                <groupfilter function="level-members" level="[none:State:nk]" />
              </groupfilter>
            </groupfilter>
          </filter>
          <sort column="[Vehicles].[none:State:nk]" direction="DESC" using="[Vehicles].[usr:Selected Measure:qk]" class="computed" />
