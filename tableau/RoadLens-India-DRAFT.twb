            </column>
            <column caption="Metric" datatype="string" name="[Metric]" param-domain-type="list" role="measure" type="nominal" value="&quot;Fatalities&quot;">
              <calculation formula="&quot;Fatalities&quot;" class="tableau" />
              <members>
                <member value="&quot;Accidents&quot;" />
                <member value="&quot;Fatalities&quot;" />
                <member value="&quot;Severity&quot;" />
              </members>
            </column>
