          <filter class="categorical" column="[Totals].[none:State Filter:nk]" context="true">
            <groupfilter function="member" level="[none:State Filter:nk]" member="true" />
          </filter>
          <filter class="categorical" column="[Totals].[none:State:nk]">
            <groupfilter count="[Parameters].[Top N]" end="top" function="end" units="records">
              <groupfilter direction="DESC" expression="CASE [Parameters].[Metric] WHEN 'Accidents' THEN SUM([Accidents]) WHEN 'Fatalities' THEN SUM([Fatalities]) WHEN 'Severity' THEN [Severity] END" function="order">
                <groupfilter function="level-members" level="[none:State:nk]" />
              </groupfilter>
            </groupfilter>
          </filter>
          <sort column="[Totals].[none:State:nk]" direction="DESC" using="[Totals].[usr:Selected Measure:qk]" class="computed" />
          <aggregation value="true" />
